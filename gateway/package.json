{
  "name": "open-notebook-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Messenger gateway for Open Notebook — dumb pipe between Telegram/WhatsApp and the API",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@whiskeysockets/baileys": "6.7.24",
    "grammy": "^1.46.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
